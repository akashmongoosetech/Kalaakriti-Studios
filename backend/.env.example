# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection URI
# Example (Local MongoDB): mongodb://127.0.0.1:27017/kalaakriti_studios
# Example (MongoDB Atlas): mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/kalaakriti_studios?retryWrites=true&w=majority
# Note: In development, if MONGODB_URI is left empty, the backend automatically starts a local embedded MongoDB instance.
MONGODB_URI=

# JWT Authentication
# Generate a strong random secret (at least 32 chars): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d

# Cookie Settings
COOKIE_NAME=kalaakriti_admin_token

# CORS Allowed Origins (comma-separated, no wildcard when using credentials)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=5

# Optional: Set to true to serve ../frontend/dist directly from Express in single-service deployments
SERVE_FRONTEND_DIST=false
