# Base URL of the Express backend API.
# Leave empty during local development to use Vite's built-in /api proxy (http://127.0.0.1:5000).
# For separate production deployments, set to your backend origin, e.g. https://api.kalaakritistudios.com
VITE_API_BASE_URL=

# Optional: override the local Vite dev proxy target (defaults to http://127.0.0.1:5000)
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:5000
